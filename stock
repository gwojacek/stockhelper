#!/usr/bin/env bash
set -o pipefail

_stock_source="${BASH_SOURCE[0]}"
while [[ -L "$_stock_source" ]]; do
  _stock_dir="$(cd -P "$(dirname "$_stock_source")" && pwd)"
  _stock_link="$(readlink "$_stock_source")"
  if [[ "$_stock_link" == /* ]]; then
    _stock_source="$_stock_link"
  else
    _stock_source="$_stock_dir/$_stock_link"
  fi
done
PROJECT_ROOT="$(cd -P "$(dirname "$_stock_source")" && pwd)"
cd "$PROJECT_ROOT" || exit 1

# Persistent machine-local StockHelper settings. This file is gitignored and
# is the appropriate place for secrets such as the Tor control password.
_stockhelper_local_env="$PROJECT_ROOT/.stockhelper.env"
if [[ -f "$_stockhelper_local_env" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$_stockhelper_local_env"
  set +a
fi

_stockhelper_needs_tor=0
for _stockhelper_arg in "$@"; do
  case "${_stockhelper_arg,,}" in
    --debug-stooq|forex|commodities|commodity|all|*.f|coffee|cocoa|sugar|wheat|corn|soybean|soyoil|copper|aluminium|platinum|palladium|wti|oil|natural_gas|gold|silver)
      _stockhelper_needs_tor=1
      break
      ;;
  esac
  if [[ "${_stockhelper_arg,,}" =~ ^(aud|eur|gbp|usd|chf|jpy|pln|cad)(aud|eur|gbp|usd|chf|jpy|pln|cad)$ ]]; then
    _stockhelper_needs_tor=1
    break
  fi
done

_stockhelper_manage_tor="${STOCKHELPER_MANAGE_TOR_SERVICE:-auto}"
_stockhelper_tor_started=0
_stockhelper_systemctl() {
  systemctl "$@" >/dev/null 2>&1 || sudo systemctl "$@"
}
_stockhelper_stop_tor() {
  if [[ "$_stockhelper_tor_started" == "1" ]]; then
    echo "[stock] stopping host Tor service..."
    _stockhelper_systemctl stop tor || echo "[stock] warning: could not stop host Tor service." >&2
    _stockhelper_tor_started=0
  fi
}

if [[ "$_stockhelper_needs_tor" == "1" \
   && "${STOCKHELPER_STOOQ_TOR:-1}" != "0" \
   && "$_stockhelper_manage_tor" != "0" \
   && "$_stockhelper_manage_tor" != "false" \
   && "$_stockhelper_manage_tor" != "off" ]]; then
  echo "[stock] starting host Tor service for Stooq Forex/commodity access..."
  if ! _stockhelper_systemctl start tor; then
    echo "stock: could not start Tor. Run 'sudo systemctl start tor' or set STOCKHELPER_MANAGE_TOR_SERVICE=0." >&2
    exit 1
  fi
  _stockhelper_tor_started=1
  trap _stockhelper_stop_tor EXIT
  trap '_stockhelper_stop_tor; exit 130' HUP INT TERM
fi

if [[ "${1:-}" == "--cleanup" ]]; then
  echo "Stopping StockHelper report containers..."
  docker ps -aq --filter "name=stockhelper" | xargs -r docker rm -f
  echo "Removing dangling Docker images..."
  docker image prune -f
  echo "Removing unused build cache..."
  docker builder prune -f
  echo "Done. Current StockHelper images:"
  docker images 'stockhelper*'
  exit 0
fi

if [[ "${1:-}" == "--fix-permissions" ]]; then
  echo "Fixing ownership for StockHelper generated files..."
  paths=(data charts chart_program/data Trojpolowki debug configs .docker-home)
  existing=()
  for path in "${paths[@]}"; do
    [[ -e "$path" ]] && existing+=("$path")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo "No generated StockHelper paths found."
    exit 0
  fi
  if chown -R "$(id -u):$(id -g)" "${existing[@]}" 2>/dev/null; then
    echo "Permissions fixed."
  else
    echo "Could not change every file as your user. Run this once:"
    printf '  sudo chown -R %q:%q' "$(id -u)" "$(id -g)"
    printf ' %q' "${existing[@]}"
    printf '\n'
    exit 1
  fi
  exit 0
fi

export STOCKHELPER_UID="${STOCKHELPER_UID:-$(id -u)}"
export STOCKHELPER_GID="${STOCKHELPER_GID:-$(id -g)}"

# `docker compose run` only applies variables declared by the Compose service;
# it does not automatically copy ad-hoc host variables into the container.
# Forward every StockHelper setting so invocations such as
# `STOCKHELPER_SCAN_WORKERS=8 ./stock -search commodities` actually reach the
# Python scanner (and do the same for Tor/proxy tuning variables).
_stockhelper_env_args=()
while IFS= read -r _stockhelper_env_name; do
  [[ -n "$_stockhelper_env_name" ]] && _stockhelper_env_args+=( -e "$_stockhelper_env_name" )
done < <(compgen -e | LC_ALL=C sort | awk '/^STOCKHELPER_[A-Za-z0-9_]+$/')

# A headed Playwright inspector needs the host display socket in addition to
# DISPLAY itself.  Compose does not inherit either automatically.  Forward
# them only for inspector runs so normal batch containers remain isolated.
_stockhelper_gui_args=()
for _stockhelper_arg in "$@"; do
  if [[ "$_stockhelper_arg" == "--inspector" || "$_stockhelper_arg" == "-inspector" ]]; then
    if [[ -n "${DISPLAY:-}" && -d /tmp/.X11-unix ]]; then
      _stockhelper_gui_args+=( -e DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix )
      if [[ -n "${XAUTHORITY:-}" && -f "$XAUTHORITY" ]]; then
        _stockhelper_gui_args+=( -e XAUTHORITY -v "$XAUTHORITY:$XAUTHORITY:ro" )
      elif [[ -f "${HOME}/.Xauthority" ]]; then
        _stockhelper_gui_args+=( -e XAUTHORITY=/tmp/.stockhelper.Xauthority -v "${HOME}/.Xauthority:/tmp/.stockhelper.Xauthority:ro" )
      fi
    elif [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" && -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]]; then
      _stockhelper_gui_args+=(
        -e WAYLAND_DISPLAY -e XDG_RUNTIME_DIR
        -v "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}:${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}"
      )
    else
      echo "stock: --inspector requested, but no host X11/Wayland display socket was found." >&2
    fi
    break
  fi
done

_stop_old_report_containers() {
  if [[ "${STOCKHELPER_KEEP_OLD_REPORTS:-0}" == "1" ]]; then
    return 0
  fi
  # Compose labels are stable even when the generated image/container name is
  # different from `stockhelper:latest` (for example stockhelper-stockhelper).
  docker ps -aq --filter "label=com.docker.compose.service=stockhelper" | xargs -r docker rm -f >/dev/null 2>&1 || true
}

_should_watch_for_report_url=0
for arg in "$@"; do
  case "$arg" in
    -allsearch|--open-allsearch-report|--journal-html|--journal-pdf)
      _should_watch_for_report_url=1
      ;;
  esac
done

if [[ "$_should_watch_for_report_url" == "1" ]]; then
  _stop_old_report_containers
  _opened_url=""
  docker compose run --rm --no-deps "${_stockhelper_env_args[@]}" "${_stockhelper_gui_args[@]}" stockhelper "$@" 2>&1 | while IFS= read -r line; do
    printf '%s\n' "$line"
    if [[ -z "$_opened_url" && "$line" =~ (https?://(127\.0\.0\.1|localhost):[0-9]+[^[:space:]]*) ]]; then
      _opened_url="${BASH_REMATCH[1]}"
      if command -v google-chrome >/dev/null 2>&1; then
        google-chrome --new-window "$_opened_url" >/dev/null 2>&1 &
      elif command -v chromium >/dev/null 2>&1; then
        chromium --new-window "$_opened_url" >/dev/null 2>&1 &
      elif command -v chromium-browser >/dev/null 2>&1; then
        chromium-browser --new-window "$_opened_url" >/dev/null 2>&1 &
      elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$_opened_url" >/dev/null 2>&1 &
      elif command -v gio >/dev/null 2>&1; then
        gio open "$_opened_url" >/dev/null 2>&1 &
      fi
    fi
  done
  exit "${PIPESTATUS[0]}"
fi

if [[ "$_stockhelper_tor_started" == "1" ]]; then
  docker compose run --rm --no-deps "${_stockhelper_env_args[@]}" "${_stockhelper_gui_args[@]}" stockhelper "$@"
  _stockhelper_status=$?
  exit "$_stockhelper_status"
fi
exec docker compose run --rm --no-deps "${_stockhelper_env_args[@]}" "${_stockhelper_gui_args[@]}" stockhelper "$@"
