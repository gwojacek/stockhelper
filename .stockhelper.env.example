# Copy this file to .stockhelper.env, replace the placeholder, and chmod 600 it.
# The stock launcher loads this file before forwarding STOCKHELPER_* variables
# into Docker. Never commit the real .stockhelper.env file.
STOCKHELPER_STOOQ_TOR=1
STOCKHELPER_STOOQ_TOR_PROXY='socks5://127.0.0.1:9050'
STOCKHELPER_STOOQ_TOR_CONTROL=auto
STOCKHELPER_STOOQ_TOR_CONTROL_PASSWORD='replace-with-your-tor-control-password'
